\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Cross-domain reproducibility.} DIAL (left) and target AUC (right) across four domains and two correctors (no-adapt vs naive ComBat). The flip reproduces in 4/4 domains; naive ComBat does not fix it in any domain.}}{6}{figure.5}\protected@file@percent }
\newlabel{fig:xdomain}{{5}{6}{\textbf {Cross-domain reproducibility.} DIAL (left) and target AUC (right) across four domains and two correctors (no-adapt vs naive ComBat). The flip reproduces in 4/4 domains; naive ComBat does not fix it in any domain}{figure.5}{}}

\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Numerical validation of Theorem~\ref {thm:unified}.} DIAL plotted against each of the four KL components. Only the parallel component (third panel) shows a strong slope; the others are flat. Linear regression $R^{2}=0.94$ overall with $\hat  \beta _{\parallel }/\hat  \beta _{\text  {cov}}\approx 33\times $.}}{4}{figure.1}\protected@file@percent }
\newlabel{fig:thm2}{{1}{4}{\textbf {Numerical validation of Theorem~\ref {thm:unified}.} DIAL plotted against each of the four KL components. Only the parallel component (third panel) shows a strong slope; the others are flat. Linear regression $R^{2}=0.94$ overall with $\hat \beta _{\parallel }/\hat \beta _{\text {cov}}\approx 33\times $}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Stress test phase diagram.} DIAL versus shift magnitude for the four canonical shift types. Pure covariate and pure label shifts give DIAL $= 0$ (theory predicts no flip); concept and subspace-aligned shifts both produce DIAL above zero beyond magnitude $\approx 0.5$.}}{4}{figure.2}\protected@file@percent }
\newlabel{fig:stress}{{2}{4}{\textbf {Stress test phase diagram.} DIAL versus shift magnitude for the four canonical shift types. Pure covariate and pure label shifts give DIAL $= 0$ (theory predicts no flip); concept and subspace-aligned shifts both produce DIAL above zero beyond magnitude $\approx 0.5$}{figure.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}Test-time adaptation benchmark}{4}{subsection.5.3}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.4}Foundation-model scaling}{4}{subsection.5.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {TTA benchmark.} Target AUC of ten adaptation methods. \texttt  {combat\_subtype} trivially reaches AUC $0.5$ by destroying class signal (sanity baseline). Among non-trivial methods, DANN-lite \citep  {ganin2016dann} is the strongest (AUC $0.39 \pm 0.04$); no method fully restores source-level AUC ($\sim 0.99$).}}{5}{figure.3}\protected@file@percent }
\newlabel{fig:tta}{{3}{5}{\textbf {TTA benchmark.} Target AUC of ten adaptation methods. \texttt {combat\_subtype} trivially reaches AUC $0.5$ by destroying class signal (sanity baseline). Among non-trivial methods, DANN-lite \citep {ganin2016dann} is the strongest (AUC $0.39 \pm 0.04$); no method fully restores source-level AUC ($\sim 0.99$)}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Foundation-model scaling: negative result.} DIAL (left) and target AUC (right) as functions of encoder parameter count. No monotonic relationship; linear-fit $r^2=0.19$. Larger encoders preserve label-aligned shift more faithfully and are not immunised against the flip by capacity alone.}}{5}{figure.4}\protected@file@percent }
\newlabel{fig:scaling}{{4}{5}{\textbf {Foundation-model scaling: negative result.} DIAL (left) and target AUC (right) as functions of encoder parameter count. No monotonic relationship; linear-fit $r^2=0.19$. Larger encoders preserve label-aligned shift more faithfully and are not immunised against the flip by capacity alone}{figure.4}{}}

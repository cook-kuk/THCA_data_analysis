  right: 17px;
  bottom: 15px;
  display: inline-block;
  width: 16px;
  height: 16px;
  background-size: contain;
  background-repeat: no-repeat;
  margin-left: 7px;
  transform: translateX(0px);
  transition: all 0.3s ease;
}
.press-releases > .container > .row .press-releases-content .press-release > a > .content .date {
  color: rgb(0, 0, 0);
  font-size: 0.75rem;
  margin-bottom: 15px;
}
.press-releases > .container > .row .press-releases-content .press-release > a > .content .name {
  margin: 0;
  font-weight: 300;
  color: rgb(0, 0, 0);
  line-height: 1.4;
}

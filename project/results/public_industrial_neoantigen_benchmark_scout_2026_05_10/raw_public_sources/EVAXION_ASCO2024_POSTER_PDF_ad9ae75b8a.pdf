</style>
<style id='acf-press-releases-style-inline-css' type='text/css'>
.press-releases {
  background-position: 50% 50%;
  background-size: cover;
  background-repeat: no-repeat;
  padding-top: clamp(30px, 7vw, 70px);
  padding-bottom: clamp(50px, 9vw, 100px);
}
.press-releases.visible {
  opacity: 1;
}
.press-releases > .container > .row {
  position: relative;
  justify-content: space-between;
}
.press-releases > .container > .row .title {
  display: flex;
  justify-content: space-between;
  padding: 0;
  margin-bottom: 40px;
}
@media (max-width: 575.98px) {
  .press-releases > .container > .row .title {
    flex-wrap: wrap;
    gap: 30px;
    margin-bottom: 20px;
  }
}
.press-releases > .container > .row .title > h3 {
  margin-bottom: 0;
}
@media (max-width: 499.98px) {
  .press-releases > .container > .row .title > h3 {
    line-height: 1;
  }
}
.press-releases > .container > .row .title .view-all {
  display: flex;
  gap: 36px;
  transition: all 0.3s ease-in-out;
}
@media (max-width: 767.98px) {
  .press-releases > .container > .row .title .view-all {
    gap: 12px;
  }
}
@media (max-width: 575.98px) {
  .press-releases > .container > .row .title .view-all {
    width: 100%;
    justify-content: space-between;
    flex-wrap: wrap;
  }
}
.press-releases > .container > .row .title .view-all > a {
  display: flex;
  align-items: center;
  color: rgb(0, 0, 0);
  transition: all 0.3s ease-in-out;
}
.press-releases > .container > .row .title .view-all > a:last-of-type:hover > img {
  transform: translateX(5px);
}
.press-releases > .container > .row .title .view-all > a:hover {
  text-decoration: none;
  color: rgba(0, 0, 0, 0.5);
}
.press-releases > .container > .row .title .view-all > a:hover > div {
  border-bottom: 1px solid rgba(0, 0, 0, 0.5);
}
.press-releases > .container > .row .title .view-all > a:hover > img {
  opacity: 0.5;
}
.press-releases > .container > .row .title .view-all > a > div {
  line-height: 1;
  border-bottom: 1px solid transparent;
  transition: all 0.3s ease-in-out;
}
.press-releases > .container > .row .title .view-all > a > img {
  max-width: 19px;
  margin-left: 8px;
  transform: translateX(0px);
  transition: all 0.3s ease-in-out;
}
.press-releases > .container > .row .press-releases-content {
  display: flex;
  flex-wrap: wrap;
  gap: 22px;
  padding: 0;
}
.press-releases > .container > .row .press-releases-content .press-release {
  position: relative;
  width: calc(33.33333333% - 15px);
  box-shadow: 0px 0px 10px 0px rgba(0, 0, 0, 0.1098039216);
  opacity: 0;
  transform: translateX(30px);
  transition: all 0.3s ease-in-out;
}
@media (max-width: 767.98px) {
  .press-releases > .container > .row .press-releases-content .press-release {
    width: calc(50% - 11px);
  }
}
.press-releases > .container > .row .press-releases-content .press-release.press-release-animate {
  opacity: 1;
  transform: translateX(0);
}
@media (max-width: 575.98px) {
  .press-releases > .container > .row .press-releases-content .press-release {
    width: 100%;
    transform: translateX(0) !important;
  }
}
.press-releases > .container > .row .press-releases-content .press-release.col-6 {
  width: calc(50% - 11px);
}
@media (max-width: 575.98px) {
  .press-releases > .container > .row .press-releases-content .press-release.col-6 {
    width: 100%;
  }
}
.press-releases > .container > .row .press-releases-content .press-release:hover {
  box-shadow: 0px 0px 10px 2px rgba(0, 0, 0, 0.1803921569);
  background-color: rgb(224, 236, 249);
}
.press-releases > .container > .row .press-releases-content .press-release:hover > a {
  text-decoration: none;
}
.press-releases > .container > .row .press-releases-content .press-release:hover > a > .content::after {
  transform: translateX(5px);
}
.press-releases > .container > .row .press-releases-content .press-release > a > .content {
  padding: 27px 25px 35px 20px;
  transition: all 0.3s ease-in-out;
}
.press-releases > .container > .row .press-releases-content .press-release > a > .content::after {
  content: "";
  background-image: url("/wp-content/themes/brandmonkey-base-theme-main/blocks/press-releases/../../assets/image/icons/right-full-arrow.svg");

<style id='acf-pdf-viewer-style-inline-css' type='text/css'>
.pdf-viewer {
  background-position: 50% 50%;
  background-size: cover;
  background-repeat: no-repeat;
  padding-top: clamp(50px, 9vw, 100px);
  padding-bottom: clamp(50px, 9vw, 100px);
  opacity: 0;
  transition: opacity 0.6s ease, transform 0.6s ease;
}
.pdf-viewer.visible {
  opacity: 1;
}
.pdf-viewer > .container > .row {
  position: relative;
  justify-content: space-between;
}
.pdf-viewer > .container > .row .title {
  padding: 0;
}
.pdf-viewer > .container > .row .title > h3 {
  margin-bottom: 40px;
}
.pdf-viewer > .container > .row > iframe {
  max-width: 1920px;
  margin: auto;
  padding: 0 115px;
  transform: translateZ(0); /* triggers GPU rendering */
  -webkit-transform: translateZ(0);
  will-change: transform;
  transition: all 0.3s ease;
}
@media (max-width: 1199.98px) {
  .pdf-viewer > .container > .row > iframe {
    padding: 0;
  }
}
@media (max-width: 991.98px) {
  .pdf-viewer > .container > .row > iframe {
    height: 500px;
  }
}
@media (max-width: 767.98px) {
  .pdf-viewer > .container > .row > iframe {
    height: 400px;
  }
}
@media (max-width: 575.98px) {
  .pdf-viewer > .container > .row > iframe {
    height: 300px;
  }
}
/*# sourceURL=https://evaxion.ai/wp-content/themes/brandmonkey-base-theme-main/blocks/pdf-viewer/pdf-viewer.css */
</style>
<style id='acf-cards-style-inline-css' type='text/css'>
.cards {
  background-position: 50% 50%;
  background-size: cover;
  background-repeat: no-repeat;
  padding-top: clamp(50px, 9vw, 100px);
  padding-bottom: clamp(50px, 9vw, 100px);
}
.cards > .container > .row {
  position: relative;
  justify-content: space-between;
}
.cards > .container > .row .title {
  padding: 0;
}
.cards > .container > .row .title > h3 {
  margin-bottom: 40px;
}
.cards > .container > .row .cards {
  display: flex;
  gap: 20px;
  flex-wrap: wrap;
  padding: 0;
  height: 100%;
}
.cards > .container > .row .cards .card {
  width: calc(33.33333333% - 13.4px);
  border-radius: 0;
  border: none;
  box-shadow: 0px 0px 10px 0px rgba(0, 0, 0, 0.11);
  opacity: 0;
  transform: translatex(30px);
  transition: all 0.3s ease-in-out;
}

<style id='acf-facts-style-inline-css' type='text/css'>
.facts {
  background-position: 50% 50%;
  background-size: cover;
  background-repeat: no-repeat;
  padding-top: clamp(50px, 9vw, 100px);
  padding-bottom: clamp(50px, 9vw, 100px);
}
.facts.visible {
  opacity: 1;
}
.facts > .container > .row {
  position: relative;
  justify-content: space-between;
}
.facts > .container > .row .title {
  padding: 0;
}
.facts > .container > .row .title > h3 {
  margin-bottom: 40px;
}
.facts > .container > .row .facts-content {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
  padding: 0;
}
.facts > .container > .row .facts-content .fact-item {
  width: calc(25% - 15px);
  box-shadow: 0px 0px 10px 0px rgba(0, 0, 0, 0.1098039216);
  padding: 30px 15px 25px 20px;
  opacity: 0;
  background: rgb(255, 255, 255);
  transform: translateX(30px);
  transition: opacity 0.5s ease, transform 0.5s ease;
}
@media (max-width: 991.98px) {
  .facts > .container > .row .facts-content .fact-item {
    width: calc(50% - 10px);
  }
}
.facts > .container > .row .facts-content .fact-item.fact-animate {

  }
}
.cards > .container > .row .cards .card.no_media .card-link-wrapper:hover .content .card-link-inner-wrapper .card-link {
  color: rgb(0, 0, 0);
  text-decoration: none;
  border-bottom: none;
}
.cards > .container > .row .cards .card.no_media .card-link-wrapper:hover .content .card-link-inner-wrapper::after {
  filter: none;
  transform: none;
}
.cards > .container > .row .cards .card.no_media .card-link-wrapper .content {
  padding: 50px 27px 45px;
}
.cards > .container > .row .cards .card.no_media .card-link-wrapper .content .desc {
  margin-bottom: 33px;
}
.cards > .container > .row .cards .card.no_media .card-link-wrapper .content .card-link-inner-wrapper .card-link {
  border-bottom: none;
}
.cards > .container > .row .cards .card .card-link-wrapper {
  text-decoration: none;
  height: 100%;
  line-height: 1.4;
  transition: all 0.3s ease-in-out;
}
.cards > .container > .row .cards .card .card-link-wrapper:hover {
  text-decoration: none;
}
.cards > .container > .row .cards .card .card-link-wrapper:hover .image-wrapper .card-image {
  transform: scale(1.05);
}
.cards > .container > .row .cards .card .card-link-wrapper:hover .background-wrapper .background-color .icon-wrapper > img {
  transform: scale(1.05);
}
.cards > .container > .row .cards .card .card-link-wrapper:hover .card-link-inner-wrapper::after {
  transform: translateX(5px);
  filter: brightness(0) saturate(100%) invert(53%) sepia(0%) saturate(1464%) hue-rotate(220deg) brightness(92%) contrast(86%);
}
.cards > .container > .row .cards .card .card-link-wrapper:hover .card-link-inner-wrapper .card-link {
  color: rgba(0, 0, 0, 0.5);
  text-decoration: none;
  border-bottom: 1px solid rgba(0, 0, 0, 0.5);
}
.cards > .container > .row .cards .card .card-link-wrapper .content .card-title,
.cards > .container > .row .cards .card .card-link-wrapper .content .desc,
.cards > .container > .row .cards .card .card-link-wrapper .content .card-link {
  color: rgb(0, 0, 0);
}
.cards > .container > .row .cards .card .image-wrapper,
.cards > .container > .row .cards .card .video-wrapper,
.cards > .container > .row .cards .card .background-wrapper,
.cards > .container > .row .cards .card .card-background {
  height: 240px;
  min-height: 240px;
  background-color: #d9d9d9;
}
.cards > .container > .row .cards .card .image-wrapper {
  overflow: hidden;
}
.cards > .container > .row .cards .card .image-wrapper .card-image {
  height: 100%;
  background-size: cover;
  background-repeat: no-repeat;
  transition: all 0.3s ease-in-out;
}
.cards > .container > .row .cards .card.video:hover {
  box-shadow: 0px 0px 10px 2px rgba(0, 0, 0, 0.1803921569);
}
.cards > .container > .row .cards .card.video .content {
  height: 100%;
}
.cards > .container > .row .cards .card.video .card-link-wrapper:hover .content {
  transition: all 0.3s ease-in-out;
}
.cards > .container > .row .cards .card.video .card-link-wrapper:hover .content .card-link-inner-wrapper::after {
  transform: none;
  filter: none;
}
.cards > .container > .row .cards .card.video .card-link-wrapper:hover .content .card-link-inner-wrapper .card-link {
  color: rgb(0, 0, 0);
  text-decoration: none;
}
.cards > .container > .row .cards .card.video .card-link-wrapper .content:hover .card-link-inner-wrapper::after {
  transform: translateX(5px);
  filter: brightness(0) saturate(100%) invert(53%) sepia(0%) saturate(1464%) hue-rotate(220deg) brightness(92%) contrast(86%);
}
.cards > .container > .row .cards .card.video .card-link-wrapper .content:hover .card-link-inner-wrapper .card-link {
  color: rgba(0, 0, 0, 0.5);
  text-decoration: none;
}
.cards > .container > .row .cards .card.video .video-wrapper {
  overflow: hidden;
  position: relative;
}
.cards > .container > .row .cards .card.video .video-wrapper:hover {
  cursor: pointer;
}
.cards > .container > .row .cards .card.video .video-wrapper:hover .video-placeholder {
  transform: scale(1.05);
}
.cards > .container > .row .cards .card.video .video-wrapper .video-placeholder {
  height: 100%;
  background-position: center;
  background-repeat: no-repeat;
  background-size: cover;
  transition: all 0.3s ease-in-out;
}
.cards > .container > .row .cards .card.video .video-wrapper .play-button {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100%;
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  right: 0;
  margin: auto;
}
.cards > .container > .row .cards .card.video .video-wrapper .play-button > img {
  max-width: 53px;
}
.cards > .container > .row .cards .card .background-wrapper .background-color {
  height: 100%;
  width: 100%;
}
.cards > .container > .row .cards .card .background-wrapper .background-color .icon-wrapper {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  height: 100%;
}
.cards > .container > .row .cards .card .background-wrapper .background-color .icon-wrapper > img {
  max-width: 95px;
  max-height: 95px;
  width: 100%;
  height: 100%;
  filter: brightness(0) saturate(100%) invert(22%) sepia(16%) saturate(870%) hue-rotate(155deg) brightness(90%) contrast(83%);
  transition: all 0.3s ease-in-out;
}
.cards > .container > .row .cards .card .card-background {
  background-color: #d9d9d9;
}
.cards > .container > .row .cards .card .content {
  padding: 32px 25px;
}
.cards > .container > .row .cards .card .content .card-title {
  font-weight: 400;
  margin-bottom: 12px;
}
.cards > .container > .row .cards .card .content .desc {
  font-weight: 300;
  font-family: "Poppins", sans-serif;
  margin-bottom: 0px;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}
.cards > .container > .row .cards .card .content .card-link-inner-wrapper {
  display: flex;
  align-items: center;
  margin-top: 18px;
}
.cards > .container > .row .cards .card .content .card-link-inner-wrapper::after {
  content: "";
  background-image: url("/wp-content/themes/brandmonkey-base-theme-main/blocks/cards/../../assets/image/icons/right-full-arrow.svg");
  display: inline-block;
  width: 16px;
  height: 16px;
  background-size: contain;
  background-repeat: no-repeat;
  margin-left: 7px;
  transition: all 0.3s ease;
}
.cards > .container > .row .cards .card .content .card-link-inner-wrapper:hover {
  cursor: pointer;
}
.cards > .container > .row .cards .card .content .card-link-inner-wrapper:hover::after {
  transform: translateX(5px);
  filter: brightness(0) saturate(100%) invert(53%) sepia(0%) saturate(1464%) hue-rotate(220deg) brightness(92%) contrast(86%);
}
.cards > .container > .row .cards .card .content .card-link-inner-wrapper:hover .card-link {
  color: rgba(0, 0, 0, 0.5);
  text-decoration: none;
}
.cards > .container > .row .cards .card .content .card-link-inner-wrapper .card-link {
  color: rgb(0, 0, 0);
  line-height: 1;
  border-bottom: 1px solid transparent;
  transition: all 0.3s ease-in-out;
}

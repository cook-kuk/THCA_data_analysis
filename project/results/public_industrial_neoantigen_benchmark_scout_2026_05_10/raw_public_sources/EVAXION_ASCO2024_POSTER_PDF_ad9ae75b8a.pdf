<style id='acf-header-style-inline-css' type='text/css'>
.header {
  background-position: 50% 50%;
  background-size: cover;
  background-repeat: no-repeat;
  opacity: 0;
  transition: all 0.4s ease-in-out;
}
.header.visible {
  opacity: 1;
}
.header > .container-fluid {
  padding: 0;
}
.header > .container-fluid > .row {
  position: relative;
}
.header > .container-fluid > .row .animated-logo {
  position: absolute;
  top: 0;
  bottom: 0;
  right: 0;
  margin: auto;
  z-index: 10;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
  padding: 0 40px;
}
@media (max-width: 575.98px) {
  .header > .container-fluid > .row .animated-logo {
    padding: 0 16px;
  }
}
.header > .container-fluid > .row .animated-logo .header-logo-fade {
  height: 115px;
  width: 100%;
  position: relative;
}
.header > .container-fluid > .row .animated-logo .header-logo-fade > img {
  position: absolute;
  top: 0;
  bottom: 0;
  right: 0;
  left: 0;
  margin: auto;
  opacity: 0;
  max-width: 665px;
  width: 100%;
  animation: fadein 1s forwards;
  animation-play-state: paused;
}
.header > .container-fluid > .row .animated-logo .header-logo-fade.animate > img {
  animation-play-state: running;
}
@keyframes fadein {
  to {
    opacity: 1;
  }
}
.header > .container-fluid > .row .animated-logo .desc {
  margin-top: 25px;
  font-size: 25px;
  font-weight: 300;
  color: rgb(0, 0, 0);
  letter-spacing: 3px;
  max-width: 662px;
  text-align: center;
}
@media (max-width: 575.98px) {
  .header > .container-fluid > .row .animated-logo .desc {
    font-size: 20px;
  }
}
.header > .container-fluid > .row .overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: radial-gradient(ellipse 40% 450% at center, rgb(224, 236, 250) 40%, rgba(224, 236, 250, 0.5) 110%, rgba(224, 236, 250, 0) 140%);
}
.header > .container-fluid > .row .background-wrapper {
  display: flex;
  height: 70vh;
  padding: 0;
}
.header > .container-fluid > .row .background-wrapper .background {
  width: 100%;
  height: 100%;
  background-position: center;
  background-repeat: no-repeat;
  background-size: cover;
}
.header > .container-fluid > .row .background-wrapper .background.left {
  width: 50%;
}
.header > .container-fluid > .row .background-wrapper .background.right {
  width: 50%;
}
.header > .container {
  padding: 0;
}
.header > .container > .row .subpage-header {
  display: flex;
  position: relative;
  padding: 0;
  min-height: 375px;
  overflow: hidden;
  flex-wrap: wrap;
  transition: all 0.3s ease-in-out;
}
@media (max-width: 767.98px) {
  .header > .container > .row .subpage-header {
    flex-direction: column-reverse;
  }
}
@media (max-width: 5757.98px) {
  .header > .container > .row .subpage-header {
    min-height: 368px;
  }
}
@media (max-width: 767.98px) {
  .header > .container > .row .subpage-header.no-image {
    min-height: 0;
  }
}
.header > .container > .row .subpage-header.no-image .information {
  width: 100%;
}
.header > .container > .row .subpage-header.no-image .information .inner-wrapper {
  width: 50%;
}
@media (max-width: 991.98px) {
  .header > .container > .row .subpage-header.no-image .information .inner-wrapper {
    width: 75%;
  }
}
@media (max-width: 767.98px) {
  .header > .container > .row .subpage-header.no-image .information .inner-wrapper {
    width: 100%;
    padding: 50px 40px;
  }
}
@media (max-width: 575.98px) {
  .header > .container > .row .subpage-header.no-image .information .inner-wrapper {
    padding: 40px 16px;
  }
}
.header > .container > .row .subpage-header .information {
  display: flex;
  align-items: center;
  background-color: rgb(250, 250, 250);
  width: 500px;
  transition: all 0.3s ease-in-out;
}
@media (max-width: 767.98px) {
  .header > .container > .row .subpage-header .information {
    width: 100%;
  }
}
.header > .container > .row .subpage-header .information .inner-wrapper {
  padding: 40px;
  margin-top: 3rem;
  transition: all 0.3s ease-in-out;
}
@media (max-width: 767.98px) {
  .header > .container > .row .subpage-header .information .inner-wrapper {
    margin-top: 0;
  }
}
@media (max-width: 575.98px) {
  .header > .container > .row .subpage-header .information .inner-wrapper {
    padding: 40px 16px;
  }
}
.header > .container > .row .subpage-header .information .inner-wrapper #breadcrumbs {
  position: absolute;
  top: 40px;
}
@media (max-width: 767.98px) {
  .header > .container > .row .subpage-header .information .inner-wrapper #breadcrumbs {
    position: unset;
  }
}
.header > .container > .row .subpage-header .information .inner-wrapper #breadcrumbs > span {
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: 0.75rem;
}
.header > .container > .row .subpage-header .information .inner-wrapper #breadcrumbs > span > span > a {
  display: flex;
  color: rgb(0, 0, 0);
  border-bottom: 1px solid transparent;
  transition: all 0.3s ease-in-out;
  line-height: 1;
}
.header > .container > .row .subpage-header .information .inner-wrapper #breadcrumbs > span > span > a:hover {
  border-bottom: 1px solid rgba(0, 0, 0, 0.5);
  text-decoration: none;
  color: rgba(0, 0, 0, 0.5);
}
.header > .container > .row .subpage-header .information .inner-wrapper .page-title-wrapper .page-title {
  margin-bottom: 15px;
}
.header > .container > .row .subpage-header .information .inner-wrapper .page-title-wrapper .page-title > h1 {
  font-size: 2.25rem;
  line-height: 1.2;
}
.header > .container > .row .subpage-header .information .inner-wrapper .page-title-wrapper .excerpt {
  font-weight: 300;
  line-height: 1.4;
  font-family: "Poppins", sans-serif;
}
.header > .container > .row .subpage-header .image-wrapper {
  width: calc(100% - 500px);
}
@media (max-width: 767.98px) {
  .header > .container > .row .subpage-header .image-wrapper {
    width: 100%;
  }
}
.header > .container > .row .subpage-header .image-wrapper .subpage-image {
  background-position: center;
  background-repeat: no-repeat;
  background-size: cover;
  width: 100%;
  height: 100%;
  opacity: 0.7;
}
@media (max-width: 767.98px) {
  .header > .container > .row .subpage-header .image-wrapper .subpage-image {
    min-height: 225px;
  }
}
@media (max-width: 575.98px) {
  .header > .container > .row .subpage-header .image-wrapper .subpage-image {
    min-height: 175px;
  }
}
/*# sourceURL=https://evaxion.ai/wp-content/themes/brandmonkey-base-theme-main/blocks/header/header.css */
</style>
<style id='acf-image-section-style-inline-css' type='text/css'>
.image-section {
  background-position: 50% 50%;
  background-size: cover;
  background-repeat: no-repeat;
  padding-top: clamp(50px, 9vw, 100px);
  padding-bottom: clamp(50px, 9vw, 100px);
  opacity: 0;
  transition: opacity 0.6s ease, transform 0.6s ease;
}
.image-section.visible {
  opacity: 1;
}
.image-section > .container > .row {
  position: relative;
  justify-content: space-between;
}
.image-section > .container > .row.left {
  flex-direction: row-reverse;
}
.image-section > .container > .row .image-section-content {
  display: flex;
  align-items: center;
  width: calc(50% - 55px);
  padding: 0;
}
@media (max-width: 991.98px) {
  .image-section > .container > .row .image-section-content {
    width: 100%;
  }
}
.image-section > .container > .row .image-section-content.col-12 {
  width: 100%;
}
.image-section > .container > .row .image-section-content .image-section-text {
  width: 100%;
}
.image-section > .container > .row .image-section-content .image-section-text > h3 {
  margin-bottom: 30px;
}
.image-section > .container > .row .image-section-content .image-section-text > iframe {
  height: 500px;
}
.image-section > .container > .row .image-section-content .image-section-text > p {
  margin-bottom: 25px;
}
.image-section > .container > .row .image-section-content .image-section-text > p > a {
  color: rgb(0, 0, 0);
  text-decoration: none;
}
.image-section > .container > .row .image-section-content .image-section-text > p > a:hover {
  color: rgba(0, 0, 0, 0.5);
}
.image-section > .container > .row .image-section-content .image-section-text .cta-wrapper {
  display: flex;
  align-items: center;
  padding-top: 15px;
  width: max-content;
}
.image-section > .container > .row .image-section-content .image-section-text .cta-wrapper::after {
  content: "";
  background-image: url("/wp-content/themes/brandmonkey-base-theme-main/blocks/image-section/../../assets/image/icons/right-full-arrow.svg");
  display: inline-block;
  width: 16px;
  height: 16px;
  background-size: contain;
  background-repeat: no-repeat;
  margin-left: 7px;
  transition: all 0.3s ease;
}
.image-section > .container > .row .image-section-content .image-section-text .cta-wrapper:hover {
  cursor: pointer;
}
.image-section > .container > .row .image-section-content .image-section-text .cta-wrapper:hover::after {
  transform: translateX(5px);
  filter: brightness(0) saturate(100%) invert(53%) sepia(0%) saturate(1464%) hue-rotate(220deg) brightness(92%) contrast(86%);
}
.image-section > .container > .row .image-section-content .image-section-text .cta-wrapper:hover .cta {
  color: rgba(0, 0, 0, 0.5);
  text-decoration: none;
  border-bottom: 1px solid rgba(0, 0, 0, 0.5);
}
.image-section > .container > .row .image-section-content .image-section-text .cta-wrapper .cta {
  color: rgb(0, 0, 0);
  line-height: 1;
  border-bottom: 1px solid transparent;
  transition: all 0.3s ease;
}
@media (max-width: 1199.98px) {
  .image-section > .container > .row .image-section-content .image-section-text .cta-wrapper .cta {
    font-size: 15px;
  }
}
@container (max-width: 1199.98px) {
  .image-section > .container > .row .image-section-content .image-section-text .cta-wrapper .cta {
    font-size: 15px;
  }
}
.image-section > .container > .row .image-section-media {
  display: flex;
  align-items: center;
  width: calc(50% - 55px);
  padding: 0;
  overflow: hidden;
}
@media (max-width: 991.98px) {
  .image-section > .container > .row .image-section-media {
    width: 100%;
    margin-top: 50px;
  }
}
.image-section > .container > .row .image-section-media.col-12 {
  width: 100%;
}

    width: 100%;
    transform: translateX(0) !important;
  }
}
.cards > .container > .row .cards .card.clickable:hover {
  box-shadow: 0px 0px 10px 0px rgba(0, 0, 0, 0.18);
}
.cards > .container > .row .cards .card.two {

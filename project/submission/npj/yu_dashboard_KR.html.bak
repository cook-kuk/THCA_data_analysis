<style>
*{box-sizing:border-box}
body{font-family:'Pretendard','Inter','Noto Sans KR',-apple-system,sans-serif;
     margin:0;background:#0a0e14;color:#eaeaea;line-height:1.65;font-size:14.5px}
header{padding:48px 28px 28px;border-bottom:1px solid #233;
       background:linear-gradient(135deg,rgba(13,103,101,0.18) 0%,rgba(245,166,35,0.10) 100%)}

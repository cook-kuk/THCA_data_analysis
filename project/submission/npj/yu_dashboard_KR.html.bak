.metrics{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:14px;margin:24px 0}
.tile{background:rgba(20,22,28,0.85);border:1px solid #243;border-radius:6px;padding:16px 18px}
.tile .v{font-family:'JetBrains Mono',monospace;font-size:22px;font-weight:500;color:#F5A623;line-height:1.05}
.tile .l{font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.13em;text-transform:uppercase;
         color:#888;margin-top:8px;line-height:1.45}
section{margin:36px 0}
section h2{font-size:21px;color:#7ccfcd;font-weight:400;letter-spacing:-0.005em;margin:0 0 14px;
            border-bottom:1px solid #234;padding-bottom:8px}
section h3{font-size:16.5px;color:#F5A623;font-weight:500;margin:18px 0 8px}
.card{background:#15191f;border:1px solid #243;border-radius:6px;padding:22px 24px;margin:14px 0}
.card p{color:#c8c8c8;margin:0 0 10px}
.eyebrow{font-family:'JetBrains Mono',monospace;color:#F5A623;font-size:11px;
          letter-spacing:0.16em;text-transform:uppercase;margin-bottom:6px}
.fig{background:#0d1014;border:1px solid #234;border-radius:4px;margin:16px 0;overflow:hidden}
.fig iframe{width:100%;height:420px;border:0;display:block;background:#0a0e14}
.fig .cap{padding:10px 16px;border-top:1px solid #234;font-family:'JetBrains Mono',monospace;
           font-size:11.5px;color:#888}
table{border-collapse:collapse;width:100%;font-size:13.5px;font-family:'JetBrains Mono',monospace;margin:8px 0}
th,td{padding:9px 12px;border-bottom:1px solid rgba(255,255,255,0.06);text-align:left}
th{color:#888;text-transform:uppercase;font-size:11px;letter-spacing:0.1em}
.num{text-align:right}
.hit{background:rgba(46,204,113,0.10);color:#9beec4;font-weight:600}
.warn{background:rgba(245,166,35,0.14);color:#F5A623;font-weight:600}
.flip{background:rgba(193,68,68,0.14);color:#ef9999;font-weight:600}
.qbox{background:rgba(245,166,35,0.06);border-left:3px solid #F5A623;padding:14px 18px;margin:12px 0;border-radius:0 4px 4px 0}
.qbox h4{color:#F5A623;font-size:12px;letter-spacing:0.14em;text-transform:uppercase;margin:0 0 6px}
.toc{background:#15191f;border:1px solid #243;border-radius:6px;padding:18px 22px;margin:24px 0}
.toc ol{margin:6px 0 0 18px;padding:0;color:#c8c8c8}
.toc li{margin:4px 0}
.toc a{color:#7ccfcd;text-decoration:none}
.toc a:hover{text-decoration:underline}
.dl-row{display:flex;flex-wrap:wrap;gap:8px;margin:14px 0}
.dl-row a{padding:6px 12px;background:rgba(13,103,101,0.18);border:1px solid #345;color:#7ccfcd;
          text-decoration:none;border-radius:3px;font-family:'JetBrains Mono',monospace;font-size:11.5px;
          letter-spacing:0.06em;text-transform:uppercase}
.dl-row a:hover{background:rgba(13,103,101,0.32)}
footer{padding:28px;border-top:1px solid #233;text-align:center;color:#777;font-size:12px;margin-top:60px}
@media (max-width:700px){header{padding:32px 18px 20px}.wrap{padding:18px}}
@media print{body{background:#fff;color:#222}.card,.tile{background:#fafafa;border-color:#ccc}}
